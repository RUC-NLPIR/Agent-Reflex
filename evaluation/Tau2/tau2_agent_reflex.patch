diff -ruN '--exclude=__pycache__' '--exclude=*.egg-info' '--exclude=*.pyc' a/src/tau2/config.py b/src/tau2/config.py
--- a/src/tau2/config.py	2026-10-04 05:37:07.198276987 +0800
+++ b/src/tau2/config.py	2026-10-04 05:37:08.026277861 +0800
@@ -1,3 +1,5 @@
+import os
+
 # =============================================================================
 # SIMULATION DEFAULTS (overridable via CLI)
 # =============================================================================
@@ -21,11 +23,25 @@
 DEFAULT_LLM_ARGS_AGENT = {"temperature": DEFAULT_LLM_TEMPERATURE_AGENT}
 DEFAULT_LLM_ARGS_USER = {"temperature": DEFAULT_LLM_TEMPERATURE_USER}
 
-DEFAULT_LLM_NL_ASSERTIONS = "gpt-4.1-2025-04-14"
+# These two are read straight from the module by evaluator_nl_assertions and
+# interface_agent, which pass no api_base and accept no CLI override, so they
+# are the only LLMs in a run that cannot be redirected from run_domain.py. On a
+# gateway that publishes `gpt-4.1` but not the dated snapshot, that is not a
+# graceful degradation: the retail domain is the one scored by NL assertions,
+# and its 40 assertion-bearing tasks all came back `infrastructure_error` with
+# "No available channel for model gpt-4.1-2025-04-14" while airline and telecom
+# -- scored by action and DB checks -- were untouched. The reward is then
+# averaged over all 114 with those 40 counted as zero, which reads as a low
+# score rather than a broken run. Env vars keep the upstream default intact.
+DEFAULT_LLM_NL_ASSERTIONS = os.environ.get(
+    "TAU2_LLM_NL_ASSERTIONS", "gpt-4.1-2025-04-14"
+)
 DEFAULT_LLM_NL_ASSERTIONS_TEMPERATURE = 0.0
 DEFAULT_LLM_NL_ASSERTIONS_ARGS = {"temperature": DEFAULT_LLM_NL_ASSERTIONS_TEMPERATURE}
 
-DEFAULT_LLM_ENV_INTERFACE = "gpt-4.1-2025-04-14"
+DEFAULT_LLM_ENV_INTERFACE = os.environ.get(
+    "TAU2_LLM_ENV_INTERFACE", "gpt-4.1-2025-04-14"
+)
 DEFAULT_LLM_ENV_INTERFACE_TEMPERATURE = 0.0
 DEFAULT_LLM_ENV_INTERFACE_ARGS = {"temperature": DEFAULT_LLM_ENV_INTERFACE_TEMPERATURE}
 
diff -ruN '--exclude=__pycache__' '--exclude=*.egg-info' '--exclude=*.pyc' a/src/tau2/utils/llm_utils.py b/src/tau2/utils/llm_utils.py
--- a/src/tau2/utils/llm_utils.py	2026-10-04 05:37:07.198276987 +0800
+++ b/src/tau2/utils/llm_utils.py	2026-10-04 05:37:07.846277671 +0800
@@ -49,7 +49,7 @@
 )
 
 # Configure httpx connection limits for LiteLLM
-httpx_limits = httpx.Limits(max_keepalive_connections=5, max_connections=10)
+httpx_limits = httpx.Limits(max_keepalive_connections=64, max_connections=256)
 litellm.client_session = httpx.Client(limits=httpx_limits)
 litellm.aclient_session = httpx.AsyncClient(limits=httpx_limits)
 
