# Copy to evaluation/.env and fill in. This is the ONLY place credentials are read from.
#
# Boyue OpenAI-compatible gateway. It serves every external model the benches need:
#   gpt-4.1             user simulator (Tau2, ACEBench, ToolSandbox, VitaBench,
#                       AgentNoiseBench), Tau2 NL-assertion judge, noise generator
#   claude-sonnet-4-6   VitaBench / AgentNoiseBench-Vita trajectory judge
BOYUE_API_KEY=
BOYUE_API_BASE_URL=http://35.220.164.252:3888/v1

# BFCL-v4 web-search category only (https://serper.dev).
SERPER_API_KEY=

# Optional proxy for GitHub / PyPI / the gateway. The local vLLM is always reached directly.
# HTTP_PROXY=
# HTTPS_PROXY=
