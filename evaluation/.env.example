# Copy to evaluation/.env and fill in. This is the ONLY place credentials are read from.
#
# Boyue API (BoyueRichData), an OpenAI-compatible gateway: register at
# https://api.boyuerichdata.opensphereai.com , create a token on the "API令牌" page
# (group: auto) and paste it below; it looks like sk-xxxxxxxx.
# Docs: https://boyuerichdata.apifox.cn/
# The key serves every external model the benches need:
#   gpt-4.1             user simulator (Tau2, ACEBench, ToolSandbox, VitaBench,
#                       AgentNoiseBench), Tau2 NL-assertion judge, noise generator
#   claude-sonnet-4-6   VitaBench / AgentNoiseBench-Vita trajectory judge
BOYUE_API_KEY=
# Mainland China / Hong Kong. Elsewhere use http://34.13.73.248:3888/v1 or
# https://api.boyuerichdata.opensphereai.com/v1.
BOYUE_API_BASE_URL=http://35.220.164.252:3888/v1

# BFCL-v4 web-search category only: register at https://serper.dev and copy the API key.
SERPER_API_KEY=

# Optional proxy for GitHub / PyPI / the gateway. The local vLLM is always reached directly.
# HTTP_PROXY=
# HTTPS_PROXY=
