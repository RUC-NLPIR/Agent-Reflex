+def parse_qwen_xml_tool_calls(content: Optional[str]) -> list[Any]:
+    """Convert Qwen's native XML tool calls when vLLM leaves them in content."""
+
+    tool_calls: list[Any] = []
+    for index, payload in enumerate(
+        re.findall(r"<tool_call>\s*(\{.*?\})\s*</tool_call>", content or "", re.DOTALL)
+    ):
+        try:
+            call = json.loads(payload)
+            name = call["name"]
+            arguments = call.get("arguments", {})
+            if isinstance(arguments, str):
+                arguments = json.loads(arguments)
+        except (json.JSONDecodeError, KeyError, TypeError):
+            continue
+        tool_calls.append(
+            SimpleNamespace(
+                id=f"qwen_call_{index}",
+                function=SimpleNamespace(
+                    name=name,
+                    arguments=json.dumps(arguments, ensure_ascii=False),
+                ),
+            )
+        )
+    return tool_calls
+
+
